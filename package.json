{
  "name": "@thatg33k/seene",
  "version": "0.1.6",
  "type": "module",
  "workspaces": [
    "examples/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run lint:architecture && tsc --noEmit && vite build && npm run build:package",
    "build:pages": "vite build --config vite.pages.config.ts --mode pages",
    "test:pages": "npm run build:pages && node --test tests/pages-build.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:core": "vitest run tests/core",
    "test:react": "vitest run tests/react",
    "test:architecture": "npm run lint:architecture && node --test tests/architecture.test.mjs",
    "test:browser": "npm run build:test && playwright test",
    "verify:surface": "npm run typecheck && npm run test:core && npm run test:react && npm run test:architecture && npm run build && npm run test:browser",
    "build:library": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "verify:motion": "npm run typecheck && npm run test:core && npm run test:react && npm run test:architecture && npm run build && npm run test:browser && npm run test:performance",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "build:cli": "vite build --config vite.cli.config.ts && node scripts/finalize-cli.mjs",
    "test:launch": "vitest run tests/project tests/preview tests/cli",
    "test:installed": "node scripts/check-installed.mjs",
    "verify:launch": "npm run verify:motion && npm run test:launch && npm run test:installed",
    "test:export": "vitest run tests/export tests/cli",
    "test:authoring": "vitest run tests/core/authoring.test.ts tests/cli",
    "build:test": "vite build --config vite.test.config.ts",
    "verify:iterate": "npm run verify:launch && npm run test:export && npm run test:iterate",
    "test:iterate": "node scripts/check-iterate.mjs",
    "verify:reuse": "npm run verify:iterate && npm run test:recipes && npm run test:library",
    "test:recipes": "vitest run tests/core/recipes.test.ts tests/project/recipes.test.ts",
    "test:library": "node scripts/check-library.mjs",
    "prepublishOnly": "npm run build:package && npm run verify:release && node scripts/release.mjs publish-check",
    "prepack": "node scripts/prepack.mjs",
    "release:local": "node scripts/pack-release.mjs",
    "verify:release": "node scripts/release.mjs check",
    "test:published": "node scripts/check-published.mjs",
    "release:publish": "npm run verify:release && node scripts/release.mjs publish",
    "build:package": "npm run build:library && npm run build:cli",
    "test:portable:app": "node scripts/check-portable.mjs app",
    "test:portable:pages": "node scripts/check-portable.mjs pages",
    "test:portable:react": "node scripts/check-portable.mjs react"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.48.0",
    "react-error-boundary": "6.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "27.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/library/types/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./preview": {
      "types": "./dist/library/types/preview/index.d.ts",
      "import": "./dist/library/preview.js"
    },
    "./style.css": "./dist/library/seene.css",
    "./vite": {
      "types": "./dist/library/types/vite/seene-plugin.d.ts",
      "import": "./dist/library/vite.js"
    },
    "./next": {
      "types": "./dist/library/types/vite/next-handler.d.ts",
      "import": "./dist/library/next.js"
    }
  },
  "files": [
    "dist/library",
    "dist/cli"
  ],
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "bin": {
    "seene": "./dist/cli/seene.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "optionalDependencies": {
    "playwright": "1.58.2"
  },
  "description": "Cinematic scene studio for real React interfaces. Seene by THATG33K.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yonela Johannes",
    "url": "https://github.com/Yonela-Johannes"
  },
  "contributors": [
    {
      "name": "THATG33K",
      "url": "https://github.com/thatg33k-t33"
    },
    {
      "name": "Yonela Johannes",
      "url": "https://github.com/Yonela-Johannes"
    }
  ],
  "homepage": "https://yonela-johannes.github.io/Seene/seene/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yonela-Johannes/Seene.git"
  },
  "bugs": {
    "url": "https://github.com/Yonela-Johannes/Seene/issues"
  },
  "sideEffects": [
    "./dist/cli/seene.js",
    "*.css"
  ]
}
